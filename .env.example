# Copy to .env.local and fill in. Never commit real values.
# --- Supabase (RLS-bound, safe for the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Server only ---
# Service role: ONLY lib/demo/admin.ts and scripts/*. Never in request paths for users.
SUPABASE_SERVICE_ROLE_KEY=
# Direct DB URL: tests/scripts only (catalog security audit).
SUPABASE_DB_URL=

# Public sign-up requires custom SMTP (or OAuth) configured in Supabase Auth.
PUBLIC_SIGNUP_ENABLED=false

DEMO_MODE_ENABLED=false
DEMO_PERSONA_SECRET=        # 32+ random bytes (hex); HMAC key for demo persona passwords
DEMO_PRESENTER_CODE=        # protects presenter slot 0
DEMO_ACCESS_CODE=           # optional gate for public demo starts
DEMO_SLOTS=0                # judge sandboxes (P8); 0 = presenter slot only
DEMO_LEASE_MINUTES=45

# Confirmed dev test accounts (scripts/create-dev-users.ts)
DEV_TEST_PASSWORD=

# --- AI (server only) ---
GEMINI_API_KEY=
GEMINI_MODEL=
AI_TIMEOUT_MS=8000
INVITE_TTL_HOURS=48

# --- Tests ---
E2E_BASE_URL=http://localhost:3000
