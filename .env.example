# Copy to .env.local and fill in. Never commit real values.
# --- Supabase (RLS-bound, safe for the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Server only ---
# Service role: ONLY lib/demo/admin.ts and scripts/*. Never in request paths for users.
SUPABASE_SERVICE_ROLE_KEY=
# Direct DB URL: tests/scripts only (catalog security audit).
SUPABASE_DB_URL=

# Public sign-up requires custom SMTP (or OAuth) configured in Supabase Auth.
PUBLIC_SIGNUP_ENABLED=false

DEMO_MODE_ENABLED=false
DEMO_PERSONA_SECRET=        # 32+ random bytes (hex); HMAC key for demo persona passwords
DEMO_SLOTS=4                # public sandboxes (slots 1..N, max 20); seed each with `npm run seed:demo -- --slots 1-N`
DEMO_LEASE_MINUTES=60       # hard session length (5–240); idle sessions end after 30 min
DEMO_STARTS_PER_HOUR=6      # new sandboxes per visitor (salted IP hash) per hour
DEMO_MAX_SESSIONS_PER_VISITOR=2  # simultaneously active sandboxes per visitor

# Confirmed dev test accounts (scripts/create-dev-users.ts)
DEV_TEST_PASSWORD=

# --- AI (server only) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_MS=18000
INVITE_TTL_HOURS=48

# --- Tests ---
E2E_BASE_URL=http://localhost:3000
